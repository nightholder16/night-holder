# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAExampleTokenReplaceMe

# Сколько часов действует оффер («Предложение действует ещё 6 ч. 0 мин.»)
OFFER_TTL_HOURS=6
# Сколько часов держится резерв сделки (текст инструкции)
RESERVE_HOURS=24
# Язык по умолчанию, если в .buy язык не указан: ru | en | ar | kit
DEFAULT_LANGUAGE=ru

# Кнопка «Передать NFT». {target} — username или id продавца
SEND_GIFT_LINK_TEMPLATE=tg://send_gift?to={target}

# Необязательно: дублировать сделки в канал/чат лога
# LOG_CHAT_ID=-1001234567890
# LOG_TOPIC_ID=0

# Таймауты и лимиты
REQUEST_TIMEOUT=15
MAX_PHOTO_BYTES=8388608
